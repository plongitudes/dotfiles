#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    q=$1
    if [[ $(xattr "$q") == *"quarantine"* ]]; then
        eval "sudo xattr -r -d com.apple.quarantine ${q}"
        echo "removed from quarantine: ${q}"
    else
        echo "${q} is not quarantined. Stopping."
    fi
else
    echo "Only provide one argument (the binary)."
fi
